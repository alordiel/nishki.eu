---
import Base from '../layouts/Base.astro'
import { ui } from '../lib/i18n'
const t = ui.bg
---

<Base locale="bg" path="/404/" title={t.notFound} noindex>
  <section class="nf wrap">
    <h1 class="caps-title">404</h1>
    <p>{t.notFoundText}</p>
    <p><a class="text-link" href="/">{t.home}</a></p>
    <p lang="en"><a class="text-link" href="/en/">{ui.en.home}</a></p>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
    padding-block: var(--section);
  }
</style>
