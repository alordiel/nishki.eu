---
import type { InstagramBlock } from '@nishki/types'
import { getSettings } from '../../lib/cms'
import type { Locale } from '../../lib/i18n'
import Icon from '../Icon.astro'
import Img from '../Img.astro'
interface Props {
  block: InstagramBlock
  locale: Locale
}
const { block, locale } = Astro.props
const url = (await getSettings(locale)).social?.instagram
---

<section class="insta">
  <Img media={block.image} sizes="max(100vw, 900px)" class="bg" cover />
  <div class="veil">
    {block.heading && <h2>{block.heading}</h2>}
    {
      url && (
        <a class="round" href={url} target="_blank" rel="noopener" aria-label="Instagram">
          <Icon name="instagram" />
        </a>
      )
    }
  </div>
</section>

<style>
  .insta {
    position: relative;
    min-height: clamp(260px, 30vw, 420px);
    display: grid;
  }
  .insta :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .veil {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 40px var(--gutter);
    background: rgb(255 254 252 / 0.56);
    text-align: center;
  }
  h2 {
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 50px);
    line-height: 1.2;
    text-transform: uppercase;
  }
  .round {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }
</style>
