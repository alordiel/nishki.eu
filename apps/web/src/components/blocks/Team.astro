---
import type { TeamBlock } from '@nishki/types'
import { href } from '../../lib/links'
import type { Locale } from '../../lib/i18n'
import Img from '../Img.astro'

interface Props {
  block: TeamBlock
  locale: Locale
}
const { block, locale } = Astro.props
const url = href(block.link, locale)
---

<section class="team wrap">
  {block.heading && <h2 class="caps-title" style="color:var(--ink)">{block.heading}</h2>}
  <div class="people">
    {
      (block.members ?? []).map((m) => (
        <figure>
          <Img media={m.image} sizes="(min-width: 1000px) 540px, 92vw" class="photo" cover />
          {m.name && <figcaption>{m.name}</figcaption>}
        </figure>
      ))
    }
  </div>
  {url && block.link?.label && <p class="more"><a class="text-link" href={url}>{block.link.label}</a></p>}
</section>

<style>
  .team {
    max-width: 1203px;
    padding-block: var(--section);
  }
  .people {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    margin-top: 64px;
  }
  figure {
    flex: 1 1 360px;
    margin: 0;
  }
  figure :global(.photo) {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
  }
  figcaption {
    margin-top: 12px;
    text-align: center;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .more {
    text-align: center;
    margin: 64px 0 0;
  }
</style>
