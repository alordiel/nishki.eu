---
import type { FeaturedProjectsBlock } from '@nishki/types'
import { isProject } from '../../lib/cms'
import { href } from '../../lib/links'
import type { Locale } from '../../lib/i18n'
import ProjectCard from './ProjectCard.astro'

interface Props {
  block: FeaturedProjectsBlock
  locale: Locale
}
const { block, locale } = Astro.props
// Unpublished projects come back as bare IDs (or drafts) — skip them.
const projects = (block.projects ?? []).filter(isProject).filter((p) => p._status !== 'draft')
const url = href(block.link, locale)
---

<section class="featured wrap">
  {block.heading && <h2 class="caps-title">{block.heading}</h2>}
  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} locale={locale} />)}
  </div>
  {url && block.link?.label && <p class="more"><a class="text-link" href={url}>{block.link.label}</a></p>}
</section>

<style>
  .featured {
    padding-block: var(--section);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-top: 56px;
  }
  .more {
    margin: 48px 0 0;
    text-align: center;
  }
</style>
