---
import type { CtaBlock } from '@nishki/types'
import { href } from '../../lib/links'
import type { Locale } from '../../lib/i18n'
interface Props {
  block: CtaBlock
  locale: Locale
}
const { block, locale } = Astro.props
const url = href(block.link, locale)
const cls = block.style === 'text' ? 'text-link' : block.style === 'outline' ? 'btn' : 'btn btn--solid'
---

{url && <p class="cta"><a class={cls} href={url}>{block.link.label}</a></p>}

<style>
  .cta {
    text-align: center;
    margin: 0;
    padding: 24px var(--gutter) clamp(48px, 6vw, 72px);
  }
</style>
