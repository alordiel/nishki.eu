---
import type { TestimonialBlock } from '@nishki/types'
import { href } from '../../lib/links'
import type { Locale } from '../../lib/i18n'
interface Props {
  block: TestimonialBlock
  locale: Locale
}
const { block, locale } = Astro.props
const url = href(block.link, locale)
---

<section class="testimonial wrap">
  <figure>
    <blockquote>“{block.quote}”</blockquote>
    {block.author && <figcaption>— {block.author}</figcaption>}
  </figure>
  {url && block.link?.label && <a class="more" href={url}>{block.link.label}</a>}
</section>

<style>
  .testimonial {
    padding-block: var(--section);
    text-align: center;
  }
  figure {
    margin: 0;
  }
  blockquote {
    margin: 0 auto;
    max-width: 800px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.3;
  }
  figcaption {
    margin-top: 16px;
    color: var(--muted);
  }
  .more {
    display: inline-block;
    margin-top: 32px;
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
