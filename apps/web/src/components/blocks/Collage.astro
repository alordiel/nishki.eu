---
/**
 * Maley-style collage: large photos, narrow gaps, horizontals and verticals mixed.
 * Pure CSS masonry (multi-column) — balanced automatically, no JavaScript, works for any count/orientation mix.
 */
import type { CollageBlock } from '@nishki/types'
import { isMedia } from '../../lib/cms'
import Img from '../Img.astro'
interface Props {
  block: CollageBlock
}
const { block } = Astro.props
const cols = Number(block.columns ?? 3)
const images = (block.images ?? []).filter(isMedia)
const sizes = `(min-width: 1240px) ${Math.round(1112 / cols)}px, (min-width: 1000px) ${Math.round(90 / cols)}vw, (min-width: 640px) 45vw, 92vw`
---

<section class="collage wrap" style={`--cols:${cols}`}>
  {images.map((m) => <Img media={m} sizes={sizes} widths={[400, 600, 900, 1300]} class="tile" />)}
</section>

<style>
  .collage {
    columns: 2;
    column-gap: 12px;
    padding-block: 12px clamp(48px, 6vw, 96px);
  }
  .collage :global(.tile) {
    width: 100%;
    margin-bottom: 12px;
    break-inside: avoid;
  }
  @media (max-width: 479.98px) {
    .collage {
      columns: 1;
    }
  }
  @media (min-width: 1000px) {
    .collage {
      columns: var(--cols);
    }
  }
</style>
