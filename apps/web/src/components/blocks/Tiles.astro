---
import type { TilesBlock } from '@nishki/types'
import Img from '../Img.astro'
interface Props {
  block: TilesBlock
}
const { block } = Astro.props
---

<section class="tiles wrap">
  {
    (block.items ?? []).map((item) =>
      item.kind === 'image' ? (
        <Img media={item.image} sizes="(min-width: 1100px) 545px, (min-width: 1000px) 46vw, 92vw" widths={[480, 800, 1100]} class="tile photo" cover />
      ) : (
        <div class="tile card">
          {item.eyebrow && <p class="eyebrow">{item.eyebrow}</p>}
          {item.heading && <h2>{item.heading}</h2>}
          {item.body && <p>{item.body}</p>}
        </div>
      ),
    )
  }
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
    gap: 24px;
  }
  .tiles :global(.tile) {
    width: 100%;
    height: 560px;
  }
  .tiles :global(.photo) {
    object-fit: cover;
  }
  .card {
    background: var(--card);
    padding: clamp(32px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 12px;
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h2 {
    margin: 0 0 16px;
    font-family: var(--serif);
    font-size: 44px;
    line-height: 1.1;
  }
  .card p:last-child {
    margin: 0;
  }
  @media (max-width: 999.98px) {
    .tiles :global(.tile.card) {
      height: auto;
    }
    .tiles :global(.tile.photo) {
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }
</style>
