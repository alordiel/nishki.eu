---
import type { SiteSetting } from '@nishki/types'
import { isMedia, mediaSrc } from '../lib/cms'
import { Image } from 'astro:assets'

interface Props {
  settings: SiteSetting
  size?: 'header' | 'footer'
}
const { settings, size = 'header' } = Astro.props
const logo = isMedia(settings.logo) ? settings.logo : null
---

{
  logo ? (
    <Image src={mediaSrc(logo)} width={logo.width ?? 226} height={logo.height ?? 164} alt={settings.siteName} class:list={['logo', size]} densities={[1, 2]} />
  ) : (
    <span class:list={['logo-text', size]}>{settings.siteName}</span>
  )
}

<style>
  .logo.header {
    height: 64px;
    width: auto;
  }
  .logo.footer {
    height: 48px;
    width: auto;
  }
  .logo-text {
    font-family: var(--serif);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .logo-text.header {
    font-size: 28px;
  }
  .logo-text.footer {
    font-size: 22px;
  }
</style>
