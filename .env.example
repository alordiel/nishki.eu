# ─── CMS (apps/cms) ─────────────────────────────────────────────
# SQLite file (relative to apps/cms). For Postgres, swap the adapter (see docs/DECISIONS.md).
DATABASE_URI=file:./data/nishki.db
# openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public origins
SERVER_URL=https://api.nishki.eu
ADMIN_URL=https://redaktor.nishki.eu
SITE_URL=https://nishki.eu
# Comma-separated list of origins allowed to POST /contact
CORS_ORIGINS=https://nishki.eu,https://www.nishki.eu

# Cloudflare Turnstile (secret, server side). Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# Email (SMTP works for Resend / Postmark / any provider). Leave EMAIL_HOST empty in dev: emails are logged instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_ADDRESS=no-reply@nishki.eu
EMAIL_FROM_NAME=Nishki
OWNER_EMAIL=
# Send a confirmation email to the person who filled in the form (true/false)
CONTACT_AUTOREPLY=false

# Publish pipeline: "hook" = POST BUILD_HOOK_URL (Cloudflare Pages / GitHub Actions), "local" = run deploy/build-and-deploy.sh
BUILD_MODE=local
BUILD_HOOK_URL=
# Extra headers for the hook as JSON, e.g. {"Authorization":"Bearer ghp_..."} for GitHub workflow_dispatch
BUILD_HOOK_HEADERS=
# Body for the hook as JSON, e.g. {"ref":"main"} for GitHub workflow_dispatch
BUILD_HOOK_BODY=
# Shared secret the CI job uses to report back to POST /api/publish/callback
BUILD_CALLBACK_SECRET=
# Absolute paths on the server (set them explicitly — don't rely on paths derived from the compiled code)
# REPO_ROOT=/var/www/vhosts/nishki.eu/nishki
# MEDIA_DIR=/var/www/vhosts/nishki.eu/nishki/apps/cms/media
# Where BUILD_MODE=local keeps site releases, and the symlink that is nishki.eu's document root
# WEB_ROOT=/var/www/vhosts/nishki.eu/nishki-web
# CURRENT_LINK=/var/www/vhosts/nishki.eu/nishki.eu

# GDPR: delete submissions older than N months (run `pnpm --filter @nishki/cms retention` from cron)
SUBMISSION_RETENTION_MONTHS=12

# ─── WEB (apps/web, build time) ─────────────────────────────────
# Where the build reads content from
CMS_URL=https://api.nishki.eu
# API key of the read-only "build" user (Users → enable API key)
CMS_API_KEY=
# Public values baked into the static site
PUBLIC_SITE_URL=https://nishki.eu
PUBLIC_CONTACT_ENDPOINT=https://api.nishki.eu/contact
# Turnstile site key. Test key that always passes: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
